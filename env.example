# ============================================
# DATABASE CONFIGURATION
# ============================================
# Choose your database setup:
# - Set DATABASE_MODE=local to run MySQL in Docker (default)
# - Set DATABASE_MODE=remote to use external database
DATABASE_MODE=local

# Local database credentials (used when DATABASE_MODE=local)
MYSQL_ROOT_PASS=hashtopolis
MYSQL_DATABASE=hashtopolis
MYSQL_USER=hashtopolis
MYSQL_PASSWORD=hashtopolis

# Remote database settings (used when DATABASE_MODE=remote)
# Uncomment and configure these when using external database
# HASHTOPOLIS_DB_HOST=192.168.x.x
# HASHTOPOLIS_DB_USER=hashtopolis
# HASHTOPOLIS_DB_PASS=hashtopolis
# HASHTOPOLIS_DB_DATABASE=hashtopolis

# Default (used for both local and remote)
HASHTOPOLIS_DB_HOST=db
HASHTOPOLIS_DB_USER=$MYSQL_USER
HASHTOPOLIS_DB_PASS=$MYSQL_PASSWORD
HASHTOPOLIS_DB_DATABASE=$MYSQL_DATABASE

# ============================================
# HASHTOPOLIS CONFIGURATION
# ============================================
HASHTOPOLIS_ADMIN_USER=admin
HASHTOPOLIS_ADMIN_PASSWORD=hashtopolis

HASHTOPOLIS_APIV2_ENABLE=0
HASHTOPOLIS_BACKEND_URL=http://localhost:8080/api/v2
